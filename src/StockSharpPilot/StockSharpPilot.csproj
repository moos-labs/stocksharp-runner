<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>StockSharpPilot</AssemblyName>
    <RootNamespace>StockSharpPilot</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pinned to the last StockSharp 5.x wave that targets net6.0 (2025-07-04),
         restorable by the .NET 8 SDK. Current StockSharp packages (5.0.230+)
         target net10.0 only. -->
    <PackageReference Include="StockSharp.Algo" Version="5.0.220" />
    <PackageReference Include="StockSharp.BusinessEntities" Version="5.0.208" />
    <PackageReference Include="StockSharp.Messages" Version="5.0.214" />
    <PackageReference Include="StockSharp.Configuration" Version="5.0.210" />
    <PackageReference Include="StockSharp.Samples.HistoryData" Version="5.0.0" />
  </ItemGroup>
</Project>
